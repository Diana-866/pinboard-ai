# Переменные окружения бэкенда PinPosy
#
# Скопируйте в .env (или задайте в панели хостинга) и заполните своими значениями.
# Файл .env в репозиторий не попадает: секреты здесь только в виде заглушек.
#
# Обязательные отмечены [обязательно]. Без них сервис либо не стартует, либо
# отключает соответствующую функцию (это указано в комментарии).

# ─── База данных (Supabase) ────────────────────────────────────────────────────
# [обязательно] Без SUPABASE_URL процесс падает при старте.
SUPABASE_URL="https://<project>.supabase.co"
# [обязательно] Ключ service_role: серверный, никогда не попадает в браузер.
# Требуется во всех окружениях, КРОМЕ явных development/test: без него процесс
# падает на старте, а не запускается частично рабочим с anon-ключом.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Публичный anon-ключ. Используется только там, где нужен клиентский ключ.
SUPABASE_ANON_KEY="<anon-key>"

# ─── Сессии ────────────────────────────────────────────────────────────────────
# [обязательно] Подпись JWT. Без него сервис предупреждает в логе и не может
# выпускать сессии. Минимум 32 случайных символа, при смене все сессии слетают.
JWT_SECRET="<random-32+-chars>"

# ─── Адреса ────────────────────────────────────────────────────────────────────
PORT="8080"
# Публичный адрес бэкенда: из него собирается webhook_url для Prodamus.
PUBLIC_BACKEND_URL="https://<backend-host>"
BACKEND_URL="https://<backend-host>"
# Адрес фронтенда: нужен для CORS и ссылок в письмах.
FRONTEND_URL="https://<frontend-host>"

# ─── AI (GPTunnel) ─────────────────────────────────────────────────────────────
# Без ключа генерация пинов и анализ сайта отвечают 503; остальной сервис работает.
GPTUNNEL_API_KEY="<gptunnel-key>"

# ─── Платежи (Prodamus) ────────────────────────────────────────────────────────
# Без SHOP_ID/SECRET приём платежей отключён (503 на /billing/*).
PRODAMUS_SHOP_ID="<shop-id>"
PRODAMUS_SECRET="<secret>"
# Отдельный секрет для вебхуков (если настроен в кабинете Prodamus).
PRODAMUS_SECRET_WEBHOOK="<webhook-secret>"
# Код интеграции SYS, если Prodamus его требует для urlNotification.
PRODAMUS_SYS=""
# Ссылка на платёжную форму, если нужен нестандартный адрес.
PRODAMUS_URL=""
# 1 — демо-платежи. Вне явных окружений development/test вебхуки демо-платежей
# отклоняются (503), чтобы демо-флаг случайно не выдал платный доступ на staging
# или на проде без заданного NODE_ENV.
PRODAMUS_DEMO="0"
# 1 — офлайн-режим: ссылка собирается локально, запросы к Prodamus не уходят.
PRODAMUS_OFFLINE="0"

# ─── Pinterest ─────────────────────────────────────────────────────────────────
# Без пары ID/SECRET все Pinterest-маршруты отвечают 503, остальное работает.
PINTEREST_CLIENT_ID="<pinterest-app-id>"
PINTEREST_CLIENT_SECRET="<pinterest-app-secret>"
PINTEREST_REDIRECT_URI="https://<backend-host>/integrations/pinterest/callback"
# [обязательно для подключения аккаунтов] Ключ шифрования токенов Pinterest
# (base64, 32 байта). Без него OAuth-подключение недоступно.
PINTEREST_TOKEN_ENCRYPTION_KEY="<base64-32-bytes>"
# Предыдущий ключ — только на время ротации, чтобы расшифровать старые токены.
PINTEREST_TOKEN_ENCRYPTION_KEY_PREVIOUS=""

# ─── Планировщик публикаций ────────────────────────────────────────────────────
# [обязательно для воркера] Адрес API, к которому воркер обращается. Отдельная
# процесса-переменная: воркер не использует PUBLIC_BACKEND_URL, если не задан
# явно. Вне localhost требуется https.
PINPOSY_BACKEND_URL="https://<backend-host>"
# [обязательно для воркера] Секрет внутреннего вызова
# POST /internal/pinterest/schedule/run. Минимум 32 символа, иначе воркер
# отказывается стартовать.
PINPOSY_SCHEDULER_SECRET="<random-32+-chars>"
# Период опроса расписания, мс (по умолчанию 30000, минимум 5000).
PINPOSY_SCHEDULER_INTERVAL_MS="30000"
# Таймаут одного тика воркера, мс (по умолчанию 120000).
PINPOSY_SCHEDULER_REQUEST_TIMEOUT_MS="120000"


# ─── Физическое удаление аккаунтов ────────────────────────────────────────────
# Отдельный Background Worker: npm run worker:account-deletion.
# Требует последовательно применённых миграций 127–145 и staging-проверки.
# Для отдельного worker переменную ниже НЕ включать на web backend.
# Встроенный режим backend по умолчанию выключен.
ACCOUNT_DELETION_WORKER_ENABLED="false"
# Интервал опроса durable queue в миллисекундах (минимум 5000, по умолчанию 30000).
ACCOUNT_DELETION_WORKER_INTERVAL_MS="30000"

# ─── Отладочные переключатели ───────────────────────────────────────────────────
# Тестовое пополнение кредитов. Работает только при NODE_ENV=development|test и
# только при точном значении "true"; в остальных случаях отвечает 503.
# ADMIN_SECRET — вторая проверка для этого маршрута; без него пополнение отключено.
ENABLE_DEV_TOPUP=""
ADMIN_SECRET=""
# Разрешить пользователю самому выбрать тариф без оплаты. Только "1" включает;
# в продакшене оставляйте пустым.
# Адрес провайдера ИИ. Шов для тестов: учитывается ТОЛЬКО при NODE_ENV=development|test,
# в production/staging и при непустом NODE_ENV игнорируется — иначе ключ провайдера и
# промпты клиентов ушли бы по адресу из переменной. Оставляйте пустым в деплое.
AI_PROVIDER_BASE_URL=""
# Адрес Pinterest API. Шов для тестов: учитывается ТОЛЬКО при NODE_ENV=development|test, иначе
# игнорируется. Нужен, чтобы безопасный повтор публикации (сверка аккаунта и доски) можно было
# проверить без реального Pinterest. В деплое оставляйте пустым.
PINTEREST_API_BASE_URL=""
ALLOW_TARIFF_SELF_SELECT=""

# ─── Ограничение частоты запросов ──────────────────────────────────────────────
# Общий бюджет запросов на один ключ (хеш bearer-токена или IP). /health и /ready
# не считаются. Счётчик живёт в памяти процесса: при нескольких инстансах бюджет
# умножается на их число. Явно ограничьте его, если инстансов больше одного.
API_RATE_LIMIT_MAX="300"
API_RATE_LIMIT_WINDOW_MS="60000"
# Отдельный бюджет для колбэков платёжного провайдера: они не подчиняются общему
# лимиту (всплеск повторных уведомлений после сбоя — легитимный трафик, а потеря
# уведомления о платеже хуже любого флуда). Минимум 60 в минуту.
WEBHOOK_RATE_LIMIT_MAX="600"
# Бюджет попыток входа на один IP (/login). Брутфорс пароля целится в конкретный
# аккаунт, поэтому второй, независимый бюджет считается на нормализованный email —
# иначе обход распределёнными адресами или несколькими инстансами умножает лимит.
# Счётчики в памяти процесса: для жёсткой гарантии нужен замок в базе (миграция).
AUTH_RATE_LIMIT_MAX="10"
LOGIN_ACCOUNT_RATE_LIMIT_MAX="10"
# Долговечный замок на аккаунт (миграция 164): после N неудачных паролей вход по этому адресу
# блокируется на указанное время. Счётчик и блокировка живут в базе, поэтому не умножаются на
# число инстансов и не сбрасываются перезапуском, в отличие от лимитов выше.
# Максимум попыток 1..50 (по умолчанию 5), блокировка 1..86400 секунд (по умолчанию 900).
LOGIN_LOCKOUT_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_SECONDS="900"

# ─── Дедлайн обращений к базе ─────────────────────────────────────────────────
# Каждый запрос к Supabase прерывается через это время. Без него зависшее соединение
# держит HTTP-запрос до таймаута платформы (минуты), хотя клиент уже ушёл. Прерывание
# не откатывает запись — это «неизвестный исход», который код уже умеет обрабатывать
# (идемпотентность, fences, сверка). Допустимый диапазон: 1000..120000 мс.
SUPABASE_REQUEST_TIMEOUT_MS="20000"

# ─── Почта ─────────────────────────────────────────────────────────────────────
# SMTP для писем (подтверждение адреса, активация подписки). Без SMTP письма
# копятся в email_outbox и не отправляются.
MAIL_SMTP_HOST="smtp.<provider>"
MAIL_SMTP_PORT="465"
MAIL_SMTP_USER="<smtp-user>"
MAIL_SMTP_PASS="<smtp-password>"
MAIL_FROM="PinPosy <no-reply@<domain>>"
# Ответы поддержки: отдельный ящик, с него уходят ответы из админки.
MAIL_REPLY_SMTP_HOST=""
MAIL_REPLY_SMTP_PORT="465"
MAIL_REPLY_SMTP_USER=""
MAIL_REPLY_SMTP_PASS=""
MAIL_REPLY_FROM=""
# Устаревшие общие креды: используются только как fallback для IMAP и ответов
# поддержки, если не заданы MAIL_IMAP_* / MAIL_REPLY_SMTP_*. Транзакционная почта
# их не использует — для неё нужны MAIL_SMTP_*.
MAIL_USER=""
MAIL_PASS=""
# IMAP для входящих писем в админке (если не задан, раздел «Почта» не работает).
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_IMAP_USER=""
MAIL_IMAP_PASS=""

# ─── Ежедневные AI-рекомендации ────────────────────────────────────────────────
# По умолчанию выключено: маршрут /recommendations/daily отвечает 404 и модель не вызывается.
# Включается только точным значением "true": одна текстовая модель на пользователя в день,
# ответ кэшируется, вход — только сохранённые доски, пины и снимки трендов.
RECOMMENDATIONS_ENABLED=""

# ─── Прочее ────────────────────────────────────────────────────────────────────
# production включает защиту от демо-платежей и строгие проверки.
# Не оставляйте пустым: незаданный NODE_ENV трактуется как нелокальное
# окружение — сервис потребует service_role-ключ и заблокирует демо-платежи.
NODE_ENV="production"
