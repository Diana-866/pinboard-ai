# Переменные окружения бэкенда PinPosy
#
# Скопируйте в .env (или задайте в панели хостинга) и заполните своими значениями.
# Файл .env в репозиторий не попадает: секреты здесь только в виде заглушек.
#
# Обязательные отмечены [обязательно]. Без них сервис либо не стартует, либо
# отключает соответствующую функцию (это указано в комментарии).

# ─── База данных (Supabase) ────────────────────────────────────────────────────
# [обязательно] Без SUPABASE_URL процесс падает при старте.
SUPABASE_URL="https://<project>.supabase.co"
# [обязательно] Ключ service_role: серверный, никогда не попадает в браузер.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Публичный anon-ключ. Используется только там, где нужен клиентский ключ.
SUPABASE_ANON_KEY="<anon-key>"

# ─── Сессии ────────────────────────────────────────────────────────────────────
# [обязательно] Подпись JWT. Без него сервис предупреждает в логе и не может
# выпускать сессии. Минимум 32 случайных символа, при смене все сессии слетают.
JWT_SECRET="<random-32+-chars>"

# ─── Адреса ────────────────────────────────────────────────────────────────────
PORT="8080"
# Публичный адрес бэкенда: из него собирается webhook_url для Prodamus.
PUBLIC_BACKEND_URL="https://<backend-host>"
BACKEND_URL="https://<backend-host>"
# Адрес фронтенда: нужен для CORS и ссылок в письмах.
FRONTEND_URL="https://<frontend-host>"

# ─── AI (GPTunnel) ─────────────────────────────────────────────────────────────
# Без ключа генерация пинов и анализ сайта отвечают 503; остальной сервис работает.
GPTUNNEL_API_KEY="<gptunnel-key>"

# ─── Платежи (Prodamus) ────────────────────────────────────────────────────────
# Без SHOP_ID/SECRET приём платежей отключён (503 на /billing/*).
PRODAMUS_SHOP_ID="<shop-id>"
PRODAMUS_SECRET="<secret>"
# Отдельный секрет для вебхуков (если настроен в кабинете Prodamus).
PRODAMUS_SECRET_WEBHOOK="<webhook-secret>"
# Код интеграции SYS, если Prodamus его требует для urlNotification.
PRODAMUS_SYS=""
# Ссылка на платёжную форму, если нужен нестандартный адрес.
PRODAMUS_URL=""
# 1 — демо-платежи. На проде с NODE_ENV=production вебхуки демо-платежей
# отклоняются (503), чтобы демо-флаг случайно не выдавал платный доступ.
PRODAMUS_DEMO="0"
# 1 — офлайн-режим: ссылка собирается локально, запросы к Prodamus не уходят.
PRODAMUS_OFFLINE="0"

# ─── Pinterest ─────────────────────────────────────────────────────────────────
# Без пары ID/SECRET все Pinterest-маршруты отвечают 503, остальное работает.
PINTEREST_CLIENT_ID="<pinterest-app-id>"
PINTEREST_CLIENT_SECRET="<pinterest-app-secret>"
PINTEREST_REDIRECT_URI="https://<backend-host>/integrations/pinterest/callback"
# [обязательно для подключения аккаунтов] Ключ шифрования токенов Pinterest
# (base64, 32 байта). Без него OAuth-подключение недоступно.
PINTEREST_TOKEN_ENCRYPTION_KEY="<base64-32-bytes>"
# Предыдущий ключ — только на время ротации, чтобы расшифровать старые токены.
PINTEREST_TOKEN_ENCRYPTION_KEY_PREVIOUS=""

# ─── Планировщик публикаций ────────────────────────────────────────────────────
# Адрес API, к которому обращается worker. PINPOSY_BACKEND_URL имеет приоритет;
# если он не задан, worker использует PUBLIC_BACKEND_URL. Вне localhost требуется https.
PINPOSY_BACKEND_URL="https://<backend-host>"
# [обязательно для воркера] Секрет внутреннего вызова
# POST /internal/pinterest/schedule/run. Минимум 32 символа, иначе воркер
# отказывается стартовать.
PINPOSY_SCHEDULER_SECRET="<random-32+-chars>"
# Период опроса расписания, мс (по умолчанию 30000, минимум 5000).
PINPOSY_SCHEDULER_INTERVAL_MS="30000"
# Таймаут одного тика воркера, мс (по умолчанию 120000).
PINPOSY_SCHEDULER_REQUEST_TIMEOUT_MS="120000"


# ─── Физическое удаление аккаунтов ────────────────────────────────────────────
# Отдельный Background Worker: npm run worker:account-deletion.
# Требует последовательно применённых миграций 127–145 и staging-проверки.
# Для отдельного worker переменную ниже НЕ включать на web backend.
# Встроенный режим backend по умолчанию выключен.
ACCOUNT_DELETION_WORKER_ENABLED="false"
# Интервал опроса durable queue в миллисекундах (минимум 5000, по умолчанию 30000).
ACCOUNT_DELETION_WORKER_INTERVAL_MS="30000"

# ─── Почта ─────────────────────────────────────────────────────────────────────
# SMTP для писем (подтверждение адреса, активация подписки). Без SMTP письма
# копятся в email_outbox и не отправляются.
MAIL_SMTP_HOST="smtp.<provider>"
MAIL_SMTP_PORT="465"
MAIL_SMTP_USER="<smtp-user>"
MAIL_SMTP_PASS="<smtp-password>"
MAIL_FROM="PinPosy <no-reply@<domain>>"
# Ответы поддержки: отдельный ящик, с него уходят ответы из админки.
MAIL_REPLY_SMTP_HOST=""
MAIL_REPLY_SMTP_PORT="465"
MAIL_REPLY_SMTP_USER=""
MAIL_REPLY_SMTP_PASS=""
MAIL_REPLY_FROM=""
# IMAP для входящих писем в админке (если не задан, раздел «Почта» не работает).
MAIL_IMAP_HOST=""
MAIL_IMAP_PORT="993"
MAIL_IMAP_USER=""
MAIL_IMAP_PASS=""

# ─── Прочее ────────────────────────────────────────────────────────────────────
# production включает защиту от демо-платежей и строгие проверки.
NODE_ENV="production"
