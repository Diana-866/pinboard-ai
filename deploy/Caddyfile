# HTTPS для сайта и API на одном домене. Caddy сам получает сертификат Let's Encrypt.
# Подставьте свой домен в CADDY_DOMAIN через переменные окружения compose.
{
	email {$CADDY_EMAIL}
}

{$CADDY_DOMAIN} {
	encode zstd gzip

	# API отдаётся с того же домена, поэтому CORS и куки не требуют отдельного хоста.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:3000
	}

	# Health без префикса: им пользуются внешние мониторы и HEALTHCHECK.
	handle /health {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
