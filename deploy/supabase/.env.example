# Параметры self-hosted Supabase (deploy/supabase).
#
# Скопируйте в deploy/supabase/.env и заполните. Файл .env в репозиторий не попадает.
# Все три ключа выводятся из одного JWT_SECRET: сгенерируйте секрет и два ключа командами
# из OWNER_STEPS.md (раздел «Развёртывание», шаг Supabase).

# Пароль суперпользователя базы. Сгенерируйте hex: openssl rand -hex 32 (URL-safe).
POSTGRES_PASSWORD=""

# Общий секрет подписи токенов. 32+ случайных байта, например base64:
#   openssl rand -base64 32
JWT_SECRET=""

# Ключи API (HS256, подписываются JWT_SECRET). Генерация — в OWNER_STEPS.md.
ANON_KEY=""
SERVICE_ROLE_KEY=""

# Внешний адрес auth-сервиса. Внутри сети compose, наружу не открывается:
#   http://kong:8000 — если Kong доступен только внутри этой сети.
API_EXTERNAL_URL="http://supabase-kong:8000"
