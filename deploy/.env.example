# Переменные окружения развёртывания (deploy/docker-compose.yml)
#
# Скопируйте в deploy/.env и заполните. Файл .env в репозиторий не попадает:
# здесь только заглушки. Секреты вводите прямо на сервере, не присылайте их в чат.
#
# Этот файл читает compose (`env_file` для сервисов и `${...}` для подстановки).
# Он не заменяет backend/.env.example: там описаны переменные самого бэкенда,
# здесь — только то, что нужно самому compose.

# ─── Домен и сертификат ───────────────────────────────────────────────────────
# [обязательно] Домен сайта. Caddy получит для него сертификат Let's Encrypt,
# поэтому DNS-запись A должна уже указывать на этот сервер.
CADDY_DOMAIN="www.pinposy.com"
# [обязательно] Почта для уведомлений Let's Encrypt о истечении сертификата.
CADDY_EMAIL="<ваша-почта>"

# ─── Адрес API для сборки фронтенда ───────────────────────────────────────────
# Фронтенд и API живут на одном домене, поэтому адрес относительный и попадает
# в бандл на этапе сборки. Секретов здесь быть не может.
VITE_API_URL="/api"

# ─── Self-hosted Supabase (внутренняя Docker-сеть pinposy-internal) ────────────
# Базовый URL, без /rest/v1: supabase-js добавляет REST-путь сам.
SUPABASE_URL="http://supabase-kong:8000"
SUPABASE_ANON_KEY="<generated-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<generated-service-role-key>"
# JWT_SECRET приложения PinPosy — отдельный секрет, НЕ Supabase JWT_SECRET.
JWT_SECRET="<random-32+-chars>"

# ─── Переменные бэкенда ───────────────────────────────────────────────────────
# compose передаёт сервисам файл env_file (deploy/.env), поэтому значения
# бэкенда (SUPABASE_*, JWT_SECRET, MAIL_*, PRODAMUS_*, GPTUNNEL_*, PINTEREST_*,
# PINPOSY_SCHEDULER_SECRET и остальные) кладутся в тот же файл.
# Полный список с пояснениями — backend/.env.example.
