# Статический фронтенд: сборка Vite на этапе build, раздача через Caddy.
# Собирать из корня репозитория: docker build -f deploy/Dockerfile.web --build-arg VITE_API_URL=... .
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci && npm cache clean --force
COPY frontend/ ./
# Адрес API попадает в бандл на этапе сборки — секретов здесь быть не должно.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
